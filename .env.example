BOT_TOKEN=your_token_from_botfather
MY_CHAT_ID=your_chat_id_from_userinfobot

# Бесплатный Gemini (aistudio.google.com/apikey) - основной оценщик фриланс-заказов.
# Без ключа заказы приходят без AI-оценки (пометка «без AI»).
GEMINI_API_KEY=
# Цепочка бесплатных моделей по порядку (у каждой свой лимит; при 429/сбое берётся следующая)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemma-4-31b-it

# YandexGPT (yandexgpt-lite) - ПЛАТНЫЙ (бесплатен только стартовый грант), по умолчанию ВЫКЛЮЧЕН.
# Вызывается только если YANDEX_ENABLED=1 И yandex есть в AI_PROVIDERS (не больше
# YANDEX_MAX_PER_DAY=60 запросов в сутки). Без YANDEX_ENABLED=1 не вызывается никогда, даже с ключами.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_ENABLED=1

# Цена фриланс-заказа считается кодом: часы x ставка x коэффициент риска
# FREELANCE_RATE_PER_HOUR=1000
# FREELANCE_PRICE_SPREAD=0.15
# Минимум по категории (tg_bot, parser, landing, site_fix, wp, script, integration, sheets, other)
# FREELANCE_MIN_PRICE_TG_BOT=3000

# Запасные бесплатные AI-провайдеры (взаимозамещение с Gemini).
# Только бесплатные тарифы и модели. Ключи берите ТОЛЬКО из аккаунтов без привязанной карты/биллинга
# (у Google AI Studio - проект без Billing), иначе лимит может превратиться в платное списание.
# Карта не требуется (по состоянию на октябрь 2026, сверяйте с сайтами). Провайдер без ключа пропускается.
# Если провайдер в лимите или ключ отклонён - заказ сразу уходит следующему.
# Порядок цепочки (неизвестные имена игнорируются; при опечатке или цепочке без ключей берётся
# цепочка по умолчанию, в логе ERROR):
AI_PROVIDERS=gemini,groq,cerebras,mistral,openrouter

# Groq - https://console.groq.com/keys (бесплатный тариф, без карты)
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_MIN_INTERVAL_SEC=2.5
# GROQ_MAX_PER_DAY=900

# Cerebras - https://cloud.cerebras.ai (бесплатный тариф: 5 запросов/мин, 1M токенов/сутки)
CEREBRAS_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3.8-27b
# CEREBRAS_MIN_INTERVAL_SEC=12.5
# CEREBRAS_MAX_PER_DAY=300

# Mistral - https://console.mistral.ai/api-keys (бесплатный тариф Experiment;
# на нём данные запросов могут использоваться для обучения моделей)
MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-small-latest,ministral-8b-latest
# MISTRAL_MIN_INTERVAL_SEC=1.2
# MISTRAL_MAX_PER_DAY=1000

# OpenRouter - https://openrouter.ai/keys. Только модели с суффиксом :free или
# openrouter/free (платные из списка отбрасываются, цены сверяются с /models).
# Без пополнения баланса лимит 50 запросов/сутки на все :free-модели вместе.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free
# OPENROUTER_MIN_INTERVAL_SEC=3.5
# OPENROUTER_MAX_PER_DAY=45
# OPENROUTER_REFERER=   # необязательно: HTTP-Referer для рейтингов OpenRouter (без личных данных)

# Дольше этого ждать очередь запросов к провайдеру не будем - заказ уйдёт следующему
# AI_PROVIDER_MAX_WAIT_SEC=20
